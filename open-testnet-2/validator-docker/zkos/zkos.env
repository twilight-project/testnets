# snapshot file location path
SNAPSHOT_FILE_LOCATION=./zkos_snapshot/snapshot_storage/map
# start taking snapshot after given blocks procced
# snapshot blockheight checkpoint
SNAPSHOT_BLOCKHEIGHT_THRESHOLD=1000

# start taking snapshot after given miliseconds
SNAPSHOT_DURATION_THRESHOLD=0

# PostgreSQL url for utxo insert and remove
POSTGRESQL_URL=postgresql://postgres:postgres_zkoracle@zkos_database:5432/zkoracle_db
NYKS_BLOCK_SUBSCRIBER_URL=http://nyks:1317
ZKORACLE_TX_SUBMIT_URL=http://nyks:7000
BLOCK_HEIGHT_FILE=height.txt
ZKOS_RPC_SERVER_URL_PORT=0.0.0.0:3030